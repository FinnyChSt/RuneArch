{
  "name": "flowcanvas",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --filter @flowcanvas/shared build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @flowcanvas/shared build && pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @flowcanvas/shared build && pnpm -r test",
    "e2e": "pnpm --filter e2e e2e"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
